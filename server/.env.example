# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID by sending a message to your bot, then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Public URL of the deployed site (used to resolve product image URLs for Telegram)
# Defaults to: https://menghuy711.github.io/ML-Studio-Frontend
SITE_URL=https://menghuy711.github.io/ML-Studio-Frontend

# Server port (optional, defaults to 3001)
PORT=3001
